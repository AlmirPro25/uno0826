# =========================================
# PROST-QS - ENVIRONMENT CONFIGURATION
# =========================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Substitua os valores de exemplo por valores reais
# 3. NUNCA commite o .env no repositório
#
# Última atualização: 19/01/2026
# =========================================

# =========================================
# CORE SECURITY (OBRIGATÓRIO - 32 bytes cada)
# =========================================
# Gere com: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32

JWT_SECRET=your_jwt_secret_must_be_32bytes!
AES_SECRET_KEY=your_aes_key_must_be_32bytes_!!
SECRETS_MASTER_KEY=your_master_key_32bytes_minimum!

# =========================================
# SERVER CONFIGURATION
# =========================================
SERVER_PORT=8080
GIN_MODE=debug
# Opções: debug, release, test

# =========================================
# DATABASE
# =========================================
# Para PostgreSQL (produção):
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Para SQLite (desenvolvimento):
SQLITE_DB_PATH=./prostqs.db

# =========================================
# CORS - Origens Permitidas
# =========================================
# Em desenvolvimento:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Em produção (exemplo):
# ALLOWED_ORIGINS=https://app.prostqs.com.br,https://admin.prostqs.com.br

# =========================================
# WAR OBSERVABILITY - Thresholds
# =========================================
# Taxa de erro (%) para cada nível de pressão
WAROBS_ERROR_RATE_ELEVATED=5.0
WAROBS_ERROR_RATE_HIGH=15.0
WAROBS_ERROR_RATE_CRITICAL=30.0

# Latência (ms) para cada nível
WAROBS_LATENCY_ELEVATED_MS=500
WAROBS_LATENCY_HIGH_MS=1000
WAROBS_LATENCY_CRITICAL_MS=3000

# Memória (%) para cada nível
WAROBS_MEMORY_ELEVATED_PERCENT=70.0
WAROBS_MEMORY_HIGH_PERCENT=85.0
WAROBS_MEMORY_CRITICAL_PERCENT=95.0

# Goroutines para cada nível
WAROBS_GOROUTINE_ELEVATED=1000
WAROBS_GOROUTINE_HIGH=5000
WAROBS_GOROUTINE_CRITICAL=10000

# Mínimo de requests/min para considerar métricas válidas
WAROBS_MIN_REQUESTS_THRESHOLD=10

# =========================================
# AI / COGNITIVE SERVICES
# =========================================
# Gemini (Narrative Intelligence)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_NARRATOR_ENABLED=false

# OpenAI (opcional)
OPENAI_API_KEY=

# =========================================
# FEATURE FLAGS
# =========================================
DEBUG_MODE=false
AGENTS_ENABLED=true
AGENT_MEMORY_ENABLED=false
LOCAL_STORE_ENABLED=false

# =========================================
# STRIPE (Billing)
# =========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# =========================================
# OAUTH PROVIDERS
# =========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================================
# EXTERNAL SERVICES
# =========================================
# Sentry (Error Monitoring)
SENTRY_DSN=

# Email (Notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =========================================
# DEPLOYMENT
# =========================================
# Render / Oracle Cloud
RENDER_SERVICE_ID=
ORACLE_INSTANCE_IP=

# =========================================
# DEVELOPMENT ONLY
# =========================================
# Apenas para desenvolvimento local
# NUNCA use em produção!
# HOT_RELOAD=true
# SKIP_AUTH=false
