# ========================================
# PROST-QS KERNEL - CONFIGURAÇÃO
# ========================================
# NUNCA COMMITE O ARQUIVO .env COM VALORES REAIS
# Use variáveis de ambiente do seu provedor (Render, Railway, etc.)

# ========================================
# OBRIGATÓRIOS - GERE VALORES ÚNICOS!
# ========================================

# JWT Secret - MÍNIMO 32 caracteres, use: openssl rand -base64 32
JWT_SECRET=

# AES Key para criptografia - EXATAMENTE 32 bytes, use: openssl rand -base64 32 | head -c 32
AES_SECRET_KEY=

# Master Key para Secrets - EXATAMENTE 32 bytes, use: openssl rand -base64 32 | head -c 32
SECRETS_MASTER_KEY=

# ========================================
# SERVIDOR
# ========================================
SERVER_PORT=8080
GIN_MODE=release

# ========================================
# BANCO DE DADOS
# ========================================
# PostgreSQL (produção) - use DATABASE_URL
DATABASE_URL=

# SQLite (apenas desenvolvimento local)
SQLITE_DB_PATH=./data/prostqs.db

# ========================================
# SEGURANÇA
# ========================================
# Lista de origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://seu-frontend.vercel.app

# Habilitar modo debug (NUNCA em produção)
DEBUG_MODE=false

# ========================================
# STRIPE (Billing)
# ========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================================
# OBSERVER AGENTS
# ========================================
AGENTS_ENABLED=false
AGENT_MEMORY_ENABLED=false

# ========================================
# GEMINI (Narrator)
# ========================================
GEMINI_API_KEY=
GEMINI_NARRATOR_ENABLED=false
GEMINI_MODEL=gemini-1.5-flash

# ========================================
# BOOTSTRAP (usar apenas uma vez)
# ========================================
# Email do primeiro super_admin - REMOVER após bootstrap
# SUPER_ADMIN_EMAIL=
