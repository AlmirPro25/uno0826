# PROD CONFIG - GOOGLE CLOUD VM
PORT=8080
GIN_MODE=release

# Database Local (PostgreSQL rodando na própria VM)
DATABASE_URL=postgresql://postgres:prostqs_secure_pass@localhost:5432/prostqs?sslmode=disable

# Security Secrets (Gere novos em produção!)
JWT_SECRET=super-secret-key-change-this-in-production-min-32-chars
AES_SECRET_KEY=12345678901234567890123456789012
SECRETS_MASTER_KEY=12345678901234567890123456789012

# External URLs
API_URL=http://136.113.71.36
FRONTEND_URL=https://prostqs.com.br

# Feature Flags
ENABLE_SWAGGER=false
ENABLE_RATE_LIMIT=true
