
# Database
DATABASE_URL="postgres://user:password@localhost:5432/aiwebweaver_db?sslmode=disable"

# JWT
JWT_SECRET="supersecretkeythatisatleast32byteslongandverycomplex"
ACCESS_TOKEN_EXPIRATION_MINUTES="15"
REFRESH_TOKEN_EXPIRATION_HOURS="720" # 30 days

# AES Encryption for Refresh Tokens (32 bytes for AES-256)
AES_SECRET_KEY="thisissecretkeyforrefreshaes256" # MUST be 32 bytes

# Redis
REDIS_ADDR="localhost:6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Server
SERVER_PORT="8080"
