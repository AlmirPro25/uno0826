# ===========================================
# MEDISYNC - PRODUCTION ENVIRONMENT
# ===========================================
# Copy this file and fill in your values

# Server
PORT=8080

# Database (Railway provides DATABASE_URL automatically)
# For SQLite (simple):
USE_SQLITE=true
SQLITE_FILE=medisync.db

# For PostgreSQL (recommended for production):
# USE_SQLITE=false
# DATABASE_URL=postgresql://user:password@host:5432/medisync

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING_FOR_PRODUCTION
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_EXACTLY_HERE

# Email (SendGrid recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CONSULT_PRICE_CENTS=15000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Optional: Sentry for error tracking
SENTRY_DSN=
