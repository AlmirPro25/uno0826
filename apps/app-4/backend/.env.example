# MediSync Backend - Environment Variables

# Server Configuration
PORT=8080

# Database (SQLite for development)
USE_SQLITE=true
SQLITE_FILE=medisync.db

# Database (PostgreSQL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/medisync?sslmode=disable

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Key (32 bytes for AES-256, must be exactly 32 characters)
ENCRYPTION_KEY=12345678901234567890123456789012

# Email Configuration (SMTP)
# Leave empty to disable email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@medisync.com

# Payment Configuration (Stripe)
# Leave empty to use mock payments for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Consultation Price in cents (15000 = R$ 150,00)
CONSULT_PRICE_CENTS=15000
