# ═══════════════════════════════════════════════════════════════
# NEXUS SOVEREIGN MESH NETWORK - Configuration
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# IDENTITY (CRITICAL - Change these!)
# ─────────────────────────────────────────────────────────────────
NEXUS_IDENTITY_FILE=nexus_identity.key
NEXUS_IDENTITY_PASSPHRASE="your-secure-identity-passphrase-change-me"

# ─────────────────────────────────────────────────────────────────
# DATABASE (CRITICAL - Change these!)
# ─────────────────────────────────────────────────────────────────
NEXUS_DATABASE_PATH=nexus_data.db
NEXUS_DATABASE_PASSPHRASE="your-secure-database-passphrase-change-me"

# ─────────────────────────────────────────────────────────────────
# NETWORK
# ─────────────────────────────────────────────────────────────────
NEXUS_API_PORT=8080
NEXUS_P2P_PORT=4001

# DHT Mode: false = server (full node), true = client (light node)
NEXUS_DHT_CLIENT_ONLY=false

# mDNS for local network discovery
NEXUS_ENABLE_MDNS=true

# WebRTC for audio/video calls
NEXUS_ENABLE_WEBRTC=true

# Bootstrap peers for DHT (comma-separated multiaddrs)
# NEXUS_BOOTSTRAP_PEERS="/dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bpjYzQVPdVWK8VqNRxGSb2KBCz2amWkLHPMWJ"

# STUN servers for WebRTC NAT traversal (comma-separated)
# NEXUS_STUN_SERVERS="stun.l.google.com:19302,stun1.l.google.com:19302"

# ─────────────────────────────────────────────────────────────────
# PROST-QS KERNEL INTEGRATION (Optional)
# ─────────────────────────────────────────────────────────────────
# Enable integration with Prost-QS governance kernel
NEXUS_KERNEL_ENABLED=false

# Kernel URL (production)
NEXUS_KERNEL_URL=https://uno0826.onrender.com

# App credentials (optional, for telemetry without user login)
# Get these from the Prost-QS dashboard after registering your app
NEXUS_KERNEL_APP_KEY=
NEXUS_KERNEL_APP_SECRET=
