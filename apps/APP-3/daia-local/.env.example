# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    DAIA - Configuração de Ambiente                            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# === GEMINI API (OBRIGATÓRIO PARA O BRAIN) ===
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# === SERVIDOR ===
DAIA_HOST=0.0.0.0
DAIA_PORT=8765

# === BANCO DE DADOS ===
DAIA_DB_PATH=./database/templates.db

# === EMBEDDINGS ===
DAIA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# === LIMITES ===
DAIA_MAX_TEMPLATES=10000
DAIA_SIMILARITY_THRESHOLD=0.7
