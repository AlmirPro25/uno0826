
# ========================================
# AEGIS-VII CLASSIFIED CONFIGURATION
# RENAME TO .env BEFORE DEPLOYMENT
# ========================================

# [BACKEND CONFIG]
PORT=3000
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/aegis_db"
# Secret for JWT authentication. MUST BE A LONG, RANDOM, AND SECURE STRING IN PRODUCTION.
JWT_SECRET="YOUR_SUPER_SECRET_AEGIS_KEY_HERE_CHANGE_ME_IMMEDIATELY"

# [FRONTEND CONFIG]
# In Dev, Vite's proxy handles this. In Prod, Nginx handles proxying /api.
# This variable might not be directly used by the bundled frontend in production,
# but it's good for reference or if you configure specific environments.
VITE_API_URL="http://localhost:3000"

# [SYSTEM PARAMETERS]
# Simulation tick rate in milliseconds
TICK_RATE_MS=1000
# Log Level (INFO, DEBUG, WARN, ERROR) - For server console logging.
LOG_LEVEL=INFO
