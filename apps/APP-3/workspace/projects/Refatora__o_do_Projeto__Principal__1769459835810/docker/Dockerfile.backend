
# ==========================================
# LUXE DIGITAL | Backend Engine
# Environment: Node.js 18 (Alpine Linux)
# Optimization: Production Dependencies Only
# ==========================================

FROM node:18-alpine

# Security: Run as non-root user
WORKDIR /app

# Install dependencies first (Caching layer)
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy Application Source
COPY backend/ .

# Ensure database directory permissions (SQLite)
# Assuming the app writes to ./luxe.db or ./data/luxe.db
RUN touch luxe.db && chown node:node luxe.db

USER node

# Expose API Port
EXPOSE 3000

# Healthcheck to ensure engine is purring
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Ignition
CMD ["node", "server.js"]
