
# SENTINEL NEXUS - ENVIRONMENT CONFIGURATION
# WARNING: Do not commit actual secrets to version control.

# [SERVER CONFIG]
PORT=3000
NODE_ENV=development

# [DATA LAYER]
# SQLite file path. Ensure the directory exists.
DATABASE_URL="file:./dev.db"

# [SECURITY KEYS]
# 256-bit encryption key for JWT generation
JWT_SECRET="changeme_to_something_secure_random_bytes"
JWT_EXPIRES_IN="8h"

# [CLIENT CONFIG]
# URL of the backend API (for CORS and Client requests)
VITE_API_URL="http://localhost:3000"
