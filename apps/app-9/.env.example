# Configuração da API Gemini para TranscendenceEngine
# Obtenha sua chave em: https://makersuite.google.com/app/apikey

API_KEY=sua_chave_gemini_aqui

# Exemplo:
# API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IMPORTANTE:
# 1. Renomeie este arquivo para .env.local
# 2. Substitua "sua_chave_gemini_aqui" pela sua chave real
# 3. Nunca commite o arquivo .env.local no git
# 4. Reinicie o servidor após configurar (npm run dev)

# Com a API configurada, você terá acesso a:
# - Transcendência completa com Gemini AI
# - Sugestões arquiteturais avançadas  
# - Meta-cognição em tempo real
# - Otimizações automáticas de código